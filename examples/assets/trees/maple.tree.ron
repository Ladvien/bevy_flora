    trunk_color: Srgba((
        red: 0.32,
        green: 0.21,
        blue: 0.12,
        alpha: 1.0,
    )),
    bark: (
        scan: Some(Maple),
        smooth_below: 0.03,
        fissured_above: 0.15,
    ),
    style: Natural,
)